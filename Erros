# ============================================================
# MAPEAMENTO EXATO (ARQUIVO -> ORACLE)
# ============================================================

def get_oracle_column(csv_column_name):
    """
    Traduz o nome da coluna do CSV exatamente para o nome da coluna no Oracle.
    """
    # 1. Normalização básica
    n = csv_column_name.lower().strip().replace('"', '')
    n = re.sub(r'[áàâãä]', 'a', n); n = re.sub(r'[éèêë]', 'e', n)
    n = re.sub(r'[íìîï]', 'i', n); n = re.sub(r'[óòôõö]', 'o', n)
    n = re.sub(r'[úùûü]', 'u', n); n = re.sub(r'[ç]', 'c', n)
    
    if '%' in n: n = n.replace('%', 'percentual')
    n = re.sub(r'[^a-z0-9]+', '_', n).strip('_')

    # 2. Dicionário de exceções para bater com seu Oracle exatamente
    mapeamento_critico = {
        "percentual_indice_taxa_flutuante": "PERCENTUAL_INDICE_TAXA",
        "condicao_de_resgate_antecipado": "CONDICAO_RESGATE_ANTECIPADO",
        "codigo_do_agente_de_pagamento": "CODIGO_DO_AGENTE_DE_PAGAMENTO",
        "rentabilidade_indexador_taxa_flutuante": "RENTABILIDADE_INDEXADOR_TAXA_FLUTUANTE"
    }

    return mapeamento_critico.get(n, n.upper())

# ============================================================
# UTILITÁRIOS DE LOG E PERFORMANCE
# ============================================================

def get_rows_imported(log_path):
    """Extrai a contagem de linhas do log do SQL*Loader."""
    try:
        with open(log_path, 'r', encoding='latin-1') as f:
            content = f.read()
            match = re.search(r'(\d+)\s+Rows\s+successfully\s+loaded', content)
            return match.group(1) if match else "0"
    except: return "N/A"

# ============================================================
# PROCESSO PRINCIPAL
# ============================================================

def build_ctl(csv_path, header_columns, user, date_rec):
    d_str = date_rec.strftime("%Y-%m-%d %H:%M:%S")
    
    # Termos para identificar colunas NUMBER no Oracle para tratar a vírgula
    num_terms = ['VALOR', 'QUANTIDADE', 'JUROS', 'TAXA', 'PERCENTUAL', 'CURVA', 'VENCIMENTO', 'EMISSAO', 'REGISTRADOR']

    lines = [
        "OPTIONS (DIRECT=TRUE, ERRORS=100000, BINDSIZE=20971520, READSIZE=20971520, COLUMNARRAYROWS=10000)",
        "LOAD DATA",
        "CHARACTERSET WE8MSWIN1252",
        f"INFILE '{csv_path}'",
        f"INTO TABLE {TARGET_TABLE} APPEND",
        "FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '\"'",
        "TRAILING NULLCOLS",
        "(",
        "  DATA_IMPORTACAO EXPRESSION \"SYSDATE\",",
        f"  USER_IMPORT CONSTANT '{user}',",
        f"  DATA_ARQUIVO_RECEBIMENTO EXPRESSION \"TO_DATE('{d_str}', 'YYYY-MM-DD HH24:MI:SS')\",",
    ]

    for i, col_csv in enumerate(header_columns):
        col_oracle = get_oracle_column(col_csv)
        sep = "," if i < len(header_columns) - 1 else ""
        
        # Se for coluna numérica, aplica REPLACE para converter formato PT-BR (1.234,56) para Oracle (1234.56)
        if any(t in col_oracle for t in num_terms):
            lines.append(f'  {col_oracle} CHAR(4000) "REPLACE(REPLACE(:{col_oracle}, \'.\', \'\'), \',\', \'.\')"{sep}')
        else:
            lines.append(f'  {col_oracle} CHAR(4000){sep}')
    
    lines.append(")")
    return "\n".join(lines)

def process_file(filename):
    start_proc = datetime.now()
    src = os.path.join(CSV_FOLDER, filename)
    if not os.path.isfile(src) or filename.startswith('_'): return

    try:
        # Lendo apenas o cabeçalho
        with open(src, 'r', encoding='latin-1') as f:
            header = f.readline().strip().split(';')
        
        user = os.environ.get("USERNAME", "USER")
        mtime = datetime.fromtimestamp(os.path.getmtime(src))
        
        ctl = os.path.join(WORK_DIR, f"{filename}.ctl")
        log = os.path.join(LOG_DIR, f"{filename}.log")
        bad = os.path.join(LOG_DIR, f"{filename}.bad")

        # Escreve o CTL
        with open(ctl, "w", encoding="utf-8") as f:
            f.write(build_ctl(src, header, user, mtime))

        # Executa SQL*Loader
        cmd = [SQLLDR, ORACLE_AUTH, f"control={ctl}", f"log={log}", f"bad={bad}", "skip=1", "silent=header,feedback"]
        res = subprocess.run(cmd, capture_output=True, text=True)

        duration = datetime.now() - start_proc
        
        if res.returncode in [0, 2]:
            rows = get_rows_imported(log)
            print(f"[OK] {filename} | Linhas: {rows} | Tempo: {duration}")
            shutil.move(src, os.path.join(PROC_DIR, filename))
        else:
            print(f"[ERRO] {filename} | Falha na importação. Verifique o log em _logs.")

    except Exception as e:
        print(f"[FALHA CRÍTICA] {filename}: {e}")

# ============================================================
# EXECUÇÃO PARALELA
# ============================================================

if __name__ == "__main__":
    print(f"--- Iniciando Processamento ({datetime.now().strftime('%H:%M:%S')}) ---")
    global_start = datetime.now()
    
    files = [f for f in os.listdir(CSV_FOLDER) if f.lower().endswith((".csv", ".txt"))]

    if not files:
        print("Nenhum arquivo encontrado.")
    else:
        # max_workers=3 para manter a velocidade sem travar o I/O do disco
        with ThreadPoolExecutor(max_workers=3) as executor:
            executor.map(process_file, files)

    print(f"\n--- Finalizado em: {datetime.now() - global_start} ---")
