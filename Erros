        print("Nenhum arquivo para processar.")
    else:
        # Processa 3 em paralelo
        with ThreadPoolExecutor(max_workers=3) as executor:
            executor.map(process_file, files)

    print(f"\nTempo total de execução: {datetime.now() - tempo_inicio}")
