# ============================================================
# FUNÇÕES DE NORMALIZAÇÃO
# ============================================================

def to_number(v):
    if v is None: return ""
    v = str(v).strip()
    if v == "": return ""
    v = v.replace(".", "").replace(",", ".")
    try:
        return str(float(v))
    except:
        return ""

def to_datetime(v):
    if v is None: return ""
    v = str(v).strip()
    if v == "": return ""
    dt = pd.to_datetime(v, dayfirst=True, errors="coerce")
    if pd.isna(dt): return ""
    return dt.strftime("%Y-%m-%d %H:%M:%S")

def quote(n):
    return f'"{n}"'

# ============================================================
# GERADOR DO ARQUIVO .CTL
# ============================================================

def build_ctl(data_file, tabela, colunas, usuario, data_rec):
    opts = "DIRECT=TRUE, ERRORS=100000, ROWS=100000"

    d = data_rec.strftime("%Y-%m-%d %H:%M:%S")

    linhas = [
        f"OPTIONS ({opts})",
        "LOAD DATA",
        f"INFILE '{data_file}'",
        f"INTO TABLE {tabela}",
        "APPEND",
        'FIELDS TERMINATED BY ";"',
        'OPTIONALLY ENCLOSED BY \'"\'' ,
        "(",
        f'  {quote("DATA_IMPORTACAO")} EXPRESSION "SYSDATE",',
        f'  {quote("USER_IMPORT")} CONSTANT \'{usuario}\',',
        f'  {quote("ID_UNICO_ARQUIVO")} EXPRESSION "NULL",',
        f'  {quote("DATA_ARQUIVO_RECEBIMENTO")} EXPRESSION "TO_DATE(\'{d}\',\'YYYY-MM-DD HH24:MI:SS\')",'
    ]

    for i, c in enumerate(colunas):
        sep = "," if i < len(colunas)-1 else ""
        linhas.append(f"  {quote(c)} CHAR{sep}")

    linhas.append(")")
    return "\n".join(linhas)

# ============================================================
# EXECUTA SQL*LOADER
# ============================================================

def run_sqlldr(ctl, log, bad):
    cmd = [
        SQLLDR,
        f"{ORACLE_USER}/{ORACLE_PASSWORD}@{ORACLE_DSN}",
        f"control={ctl}",
        f"log={log}",
        f"bad={bad}"
    ]
    print("[INFO] Executando SQL*Loader...")
    p = subprocess.run(cmd, capture_output=True, text=True)
    print("[SQLLDR STDERR]:")
    print(p.stderr)
    return p.returncode

# ============================================================
# PROCESSA UM ARQUIVO
# ============================================================

def process_file(filename):

    print(f"\n[INFO] Processando: {filename}")

    src = os.path.join(CSV_FOLDER, filename)
    out_csv = os.path.join(WORK_DIR, filename + "__norm.csv")
    ctl = os.path.join(WORK_DIR, filename + ".ctl")
    log = os.path.join(LOG_DIR, filename + ".log")
    bad = os.path.join(LOG_DIR, filename + ".bad")

    usuario = os.getenv("USERNAME", "USER")
    data_rec = datetime.fromtimestamp(os.path.getmtime(src))

    df = pd.read_csv(src, sep=";", dtype=str, keep_default_na=False, na_filter=False)

    colunas = list(df.columns)

    out_rows = []
    for _, row in df.iterrows():
        new = []
        for c in colunas:
            v = row[c].strip()

            if v == "":
                new.append("")
                continue

            n = to_number(v)
            if n != "":
                new.append(n)
                continue

            d = to_datetime(v)
            if d != "":
                new.append(d)
                continue

            new.append(v)

        out_rows.append(new)

    with open(out_csv, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f, delimiter=";")
        w.writerows(out_rows)

    ctl_text = build_ctl(out_csv, TARGET_TABLE, colunas, usuario, data_rec)
    with open(ctl, "w", encoding="utf-8") as f:
        f.write(ctl_text)

    rc = run_sqlldr(ctl, log, bad)
    print(f"[INFO] RC={rc}")

# ============================================================
# MAIN
# ============================================================

print("Iniciando importação com SQL*Loader...")

files = [f for f in os.listdir(CSV_FOLDER) if f.lower().endswith((".csv",".txt"))]

if not files:
    print("[ERRO] Nenhum arquivo encontrado.")
else:
    for f in files:
        process_file(f)

