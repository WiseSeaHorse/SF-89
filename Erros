# ============================================================
# NORMALIZAÇÃO DE NOMES DE COLUNAS
# ============================================================

def normalize_column_name(name):
    n = name.lower().strip().replace('"', '')
    n = re.sub(r'[áàâãä]', 'a', n)
    n = re.sub(r'[éèêë]', 'e', n)
    n = re.sub(r'[íìîï]', 'i', n)
    n = re.sub(r'[óòôõö]', 'o', n)
    n = re.sub(r'[úùûü]', 'u', n)
    n = re.sub(r'[ç]', 'c', n)
    
    if '%' in n: n = n.replace('%', 'percentual')
    n = re.sub(r'[^a-z0-9]+', '_', n)
    return n.strip('_')

# ============================================================
# DETECÇÃO DE ENCODING
# ============================================================

def get_file_info(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            header = f.readline().strip()
            return header.split(';'), "UTF8"
    except UnicodeDecodeError:
        with open(path, 'r', encoding='latin-1') as f:
            header = f.readline().strip()
            return header.split(';'), "WE8MSWIN1252"

# ============================================================
# GERADOR DO .CTL
# ============================================================

def build_ctl(csv_file, colunas_csv, usuario, data_rec, oracle_charset):
    d = data_rec.strftime("%Y-%m-%d %H:%M:%S")
    opts = "DIRECT=TRUE, ERRORS=100000, BINDSIZE=20971520, READSIZE=20971520, COLUMNARRAYROWS=10000"

    linhas = [
        f"OPTIONS ({opts})",
        "LOAD DATA",
        f"CHARACTERSET {oracle_charset}", 
        f"INFILE '{csv_file}'",
        f"INTO TABLE {TARGET_TABLE}",
        "APPEND",
        "FIELDS TERMINATED BY ';'",
        "OPTIONALLY ENCLOSED BY '\"'",
        "TRAILING NULLCOLS",
        "(",
        f"  DATA_IMPORTACAO EXPRESSION \"SYSDATE\",",
        f"  USER_IMPORT CONSTANT '{usuario}',",
        f"  DATA_ARQUIVO_RECEBIMENTO EXPRESSION \"TO_DATE('{d}', 'YYYY-MM-DD HH24:MI:SS')\",",
    ]

    numericos = ['valor', 'quantidade', 'juros', 'taxa', 'percentual', 'curva', 'vencimento', 'emissao', 'registrador']

    for i, c in enumerate(colunas_csv):
        col_banco = normalize_column_name(c)
        sep = "," if i < len(colunas_csv) - 1 else ""
        
        if any(word in col_banco for word in numericos):
            linhas.append(f'  {col_banco} CHAR(4000) "REPLACE(REPLACE(:{col_banco}, \'.\', \'\'), \',\', \'.\')"{sep}')
        else:
            linhas.append(f'  {col_banco} CHAR(4000){sep}')

    linhas.append(")")
    return "\n".join(linhas)

# ============================================================
# PROCESSAMENTO E MOVIMENTAÇÃO
# ============================================================

def process_file(filename):
    src_path = os.path.join(CSV_FOLDER, filename)
    
    # Ignora pastas e arquivos que já estão nas subpastas de sistema
    if not os.path.isfile(src_path): return

    try:
        print(f"[INICIANDO] {filename}")
        
        ctl_path = os.path.join(WORK_DIR, filename + ".ctl")
        log_path = os.path.join(LOG_DIR, filename + ".log")
        bad_path = os.path.join(LOG_DIR, filename + ".bad")

        usuario = os.environ.get("USERNAME", "USER")
        data_rec = datetime.fromtimestamp(os.path.getmtime(src_path))

        colunas_originais, charset_detectado = get_file_info(src_path)

        ctl_text = build_ctl(src_path, colunas_originais, usuario, data_rec, charset_detectado)
        with open(ctl_path, "w", encoding="utf-8") as f:
            f.write(ctl_text)

        cmd = [
            SQLLDR,
            f"{ORACLE_USER}/{ORACLE_PASSWORD}@{ORACLE_DSN}",
            f"control={ctl_path}",
            f"log={log_path}",
            f"bad={bad_path}",
            "skip=1",
            "silent=header,feedback"
        ]
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        # RC 0: Sucesso total | RC 2: Sucesso com algumas linhas rejeitadas (ainda move)
        if result.returncode in [0, 2]:
            print(f"[SUCESSO] {filename} importado. Movendo para _processados.")
            dest_path = os.path.join(PROC_DIR, filename)
            
            # Se já existir um arquivo com mesmo nome lá, remove para evitar erro de movimentação
            if os.path.exists(dest_path):
                os.remove(dest_path)
            
            shutil.move(src_path, PROC_DIR)
        else:
            print(f"[ERRO] {filename} falhou (RC={result.returncode}). Mantido na pasta original.")

    except Exception as e:
        print(f"[FALHA CRÍTICA] {filename}: {str(e)}")

# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":
    tempo_inicio = datetime.now()
    
    # Filtra apenas arquivos CSV e TXT da raiz da pasta
    files = [f for f in os.listdir(CSV_FOLDER) 
             if f.lower().endswith((".csv", ".txt")) and os.path.isfile(os.path.join(CSV_FOLDER, f))]

    if not files:
        print("Nenhum arquivo para processar.")
    else:
        # Processa 3 arquivos por vez para garantir velocidade e estabilidade
        with ThreadPoolExecutor(max_workers=3) as executor:
            executor.map(process_file, files)

    print(f"\nTempo total de execução: {datetime.now() - tempo_inicio}")
