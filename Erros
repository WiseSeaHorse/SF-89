import os
import subprocess
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor

# ============================================================
# CONFIGURAÇÕES
# ============================================================

CSV_FOLDER = r"C:\Users\thatyane_soares\Documents\Projeto\CSV"
TARGET_TABLE = "TESTE2_STAGING"
ORACLE_USER = "custodia"
ORACLE_PASSWORD = "MVPCustodia2025"
ORACLE_DSN = "localhost:1522/XEPDB1"
SQLLDR = "sqlldr"

WORK_DIR = os.path.join(CSV_FOLDER, "_work")
LOG_DIR = os.path.join(CSV_FOLDER, "_logs")
os.makedirs(WORK_DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)

# ============================================================
# FUNÇÃO PARA DETECTAR ENCODING E PEGAR COLUNAS
# ============================================================

def get_file_info(path):
    # Tenta UTF-8 primeiro
    try:
        with open(path, 'r', encoding='utf-8') as f:
            header = f.readline().strip()
            return header.split(';'), "UTF8"
    except UnicodeDecodeError:
        # Se falhar, tenta Latin-1 (Windows-1252)
        with open(path, 'r', encoding='latin-1') as f:
            header = f.readline().strip()
            return header.split(';'), "WE8MSWIN1252"

# ============================================================
# GERADOR DO ARQUIVO .CTL OTIMIZADO
# ============================================================

def build_ctl(csv_file, colunas, usuario, data_rec, oracle_charset):
    d = data_rec.strftime("%Y-%m-%d %H:%M:%S")
    
    # Parâmetros de performance agressivos
    opts = "DIRECT=TRUE, ERRORS=100000, BINDSIZE=20971520, READSIZE=20971520, COLUMNARRAYROWS=10000"

    linhas = [
        f"OPTIONS ({opts})",
        "LOAD DATA",
        f"CHARACTERSET {oracle_charset}", 
        f"INFILE '{csv_file}'",
        f"INTO TABLE {TARGET_TABLE}",
        "APPEND",
        "FIELDS TERMINATED BY ';'",
        "OPTIONALLY ENCLOSED BY '\"'",
        "TRAILING NULLCOLS",
        "(",
        f"  DATA_IMPORTACAO EXPRESSION \"SYSDATE\",",
        f"  USER_IMPORT CONSTANT '{usuario}',",
        f"  DATA_ARQUIVO_RECEBIMENTO EXPRESSION \"TO_DATE('{d}', 'YYYY-MM-DD HH24:MI:SS')\",",
    ]

    for i, c in enumerate(colunas):
        col_name = c.strip().strip('"')
        sep = "," if i < len(colunas) - 1 else ""
        # Definindo CHAR(4000) para evitar erros de tamanho de campo
        linhas.append(f'  "{col_name}" CHAR(4000){sep}')

    linhas.append(")")
    return "\n".join(linhas)

# ============================================================
# PROCESSAMENTO DE ARQUIVO
# ============================================================

def process_file(filename):
    try:
        src_path = os.path.abspath(os.path.join(CSV_FOLDER, filename))
        if os.path.isdir(src_path): return

        print(f"[INICIANDO] {filename}")
        
        ctl_path = os.path.join(WORK_DIR, filename + ".ctl")
        log_path = os.path.join(LOG_DIR, filename + ".log")
        bad_path = os.path.join(LOG_DIR, filename + ".bad")

        usuario = os.environ.get("USERNAME", "USER")
        data_rec = datetime.fromtimestamp(os.path.getmtime(src_path))

        # Detecta o encoding e as colunas dinamicamente
        colunas, charset_name = get_file_info(src_path)

        # Gera o CTL com o charset detectado
        ctl_text = build_ctl(src_path, colunas, usuario, data_rec, charset_name)
        
        with open(ctl_path, "w", encoding="utf-8") as f:
            f.write(ctl_text)

        # Executa SQL*Loader
        cmd = [
            SQLLDR,
            f"{ORACLE_USER}/{ORACLE_PASSWORD}@{ORACLE_DSN}",
            f"control={ctl_path}",
            f"log={log_path}",
            f"bad={bad_path}",
            "skip=1",
            "silent=header,feedback"
        ]
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        if result.returncode in [0, 2]:
            print(f"[SUCESSO] {filename} carregado como {charset_name}")
        else:
            print(f"[ERRO] {filename} falhou. Verifique {log_path}")

    except Exception as e:
        print(f"[FALHA CRÍTICA] {filename}: {str(e)}")

# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":
    start = datetime.now()
    
    files = [f for f in os.listdir(CSV_FOLDER) 
             if f.lower().endswith((".csv", ".txt"))]

    # Processamento paralelo (ajustado para 3 workers para não travar o disco)
    with ThreadPoolExecutor(max_workers=3) as executor:
        executor.map(process_file, files)

    print(f"\nTempo total de execução: {datetime.now() - start}")
