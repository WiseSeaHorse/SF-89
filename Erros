import os
import subprocess
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor

# ============================================================
# CONFIGURAÇÕES
# ============================================================

CSV_FOLDER = r"C:\Users\thatyane_soares\Documents\Projeto\CSV"
TARGET_TABLE = "TESTE2_STAGING"
ORACLE_USER = "custodia"
ORACLE_PASSWORD = "MVPCustodia2025"
ORACLE_DSN = "localhost:1522/XEPDB1"
SQLLDR = "sqlldr"

WORK_DIR = os.path.join(CSV_FOLDER, "_work")
LOG_DIR = os.path.join(CSV_FOLDER, "_logs")
os.makedirs(WORK_DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)

# ============================================================
# GERADOR DO ARQUIVO .CTL OTIMIZADO
# ============================================================

def build_ctl(csv_file, colunas, usuario, data_rec):
    d = data_rec.strftime("%Y-%m-%d %H:%M:%S")
    
    # Parâmetros de performance:
    # BINDSIZE e READSIZE para buffers grandes
    # COLUMNARRAYROWS para processamento em lote no Direct Path
    opts = "DIRECT=TRUE, ERRORS=100000, BINDSIZE=10485760, READSIZE=10485760, COLUMNARRAYROWS=5000"

    linhas = [
        f"OPTIONS ({opts})",
        "LOAD DATA",
        "CHARACTERSET UTF8",
        f"INFILE '{csv_file}'",
        f"INTO TABLE {TARGET_TABLE}",
        "APPEND",
        "FIELDS TERMINATED BY ';'",
        "OPTIONALLY ENCLOSED BY '\"'",
        "TRAILING NULLCOLS",
        "(",
        f"  DATA_IMPORTACAO EXPRESSION \"SYSDATE\",",
        f"  USER_IMPORT CONSTANT '{usuario}',",
        f"  DATA_ARQUIVO_RECEBIMENTO EXPRESSION \"TO_DATE('{d}', 'YYYY-MM-DD HH24:MI:SS')\",",
    ]

    for i, c in enumerate(colunas):
        sep = "," if i < len(colunas) - 1 else ""
        # Lógica: O SQL*Loader lê como CHAR, e o Oracle tenta converter para o tipo da coluna destino.
        # Se você precisar tratar vírgula/ponto especificamente em colunas numéricas, 
        # use a expressão abaixo (exemplo comentado):
        # f'  "{c}" CHAR(4000) "REPLACE(REPLACE(:{c}, \'.\', \'\'), \',\', \'.\')"{sep}'
        linhas.append(f'  "{c}" CHAR(4000){sep}')

    linhas.append(")")
    return "\n".join(linhas)

# ============================================================
# PROCESSAMENTO DE ARQUIVO
# ============================================================

def process_file(filename):
    try:
        src_path = os.path.abspath(os.path.join(CSV_FOLDER, filename))
        if os.path.isdir(src_path): return

        print(f"[PROCESSANDO] {filename}")
        
        ctl_path = os.path.join(WORK_DIR, filename + ".ctl")
        log_path = os.path.join(LOG_DIR, filename + ".log")
        bad_path = os.path.join(LOG_DIR, filename + ".bad")

        usuario = os.environ.get("USERNAME", "USER")
        data_rec = datetime.fromtimestamp(os.path.getmtime(src_path))

        # Pega apenas a primeira linha para descobrir as colunas (rápido!)
        with open(src_path, 'r', encoding='utf-8') as f:
            header = f.readline().strip()
            colunas = header.split(';')

        # Gera o CTL apontando para o arquivo ORIGINAL (sem criar cópia normalizada)
        # IMPORTANTE: Usamos SKIP=1 no comando sqlldr para pular o cabeçalho
        ctl_text = build_ctl(src_path, colunas, usuario, data_rec)
        
        with open(ctl_path, "w", encoding="utf-8") as f:
            f.write(ctl_text)

        # Executa SQL*Loader com SKIP=1 para ignorar o cabeçalho original
        cmd = [
            SQLLDR,
            f"{ORACLE_USER}/{ORACLE_PASSWORD}@{ORACLE_DSN}",
            f"control={ctl_path}",
            f"log={log_path}",
            f"bad={bad_path}",
            "skip=1",
            "silent=header,feedback"
        ]
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        if result.returncode in [0, 2]: # 0 = Sucesso, 2 = Avisos (linhas ruins mas completou)
            print(f"[OK] {filename} carregado.")
        else:
            print(f"[ERRO] {filename} falhou. Verifique o log: {log_path}")

    except Exception as e:
        print(f"[FALHA CRÍTICA] {filename}: {str(e)}")

# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":
    start = datetime.now()
    
    # Lista arquivos ignorando pastas e arquivos de log
    files = [f for f in os.listdir(CSV_FOLDER) 
             if f.lower().endswith((".csv", ".txt"))]

    # max_workers=2 ou 4. Cuidado para não saturar o I/O do disco ou rede
    with ThreadPoolExecutor(max_workers=2) as executor:
        executor.map(process_file, files)

    print(f"\nTempo total de execução: {datetime.now() - start}")
